<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/space_mono_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/space_mono_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/space_mono_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/space_mono_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/space_mono_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/space_mono_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
    <font
        android:font="@font/space_mono_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/space_mono_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />
</font-family>
