<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:drawableStart="@drawable/matrix_band"
                android:drawableEnd="@drawable/matrix_band"
                android:drawablePadding="8dp"
                android:drawableTint="?android:attr/textColorTertiary"
                android:text="@string/theme_section_preview" />

            <LinearLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/bubbleColor"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/previewAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/rounded_rectangle_4dp" />

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/previewIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/square_outline"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/theme_preview_in"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/previewOutgoing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/square_key"
                        android:backgroundTint="@color/bubbleOutgoing"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/theme_preview_out"
                        android:textColor="@color/bubbleOutgoingText" />

                    <ImageView
                        android:id="@+id/previewSend"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/square_key"
                        android:contentDescription="@string/compose_send_cd"
                        android:padding="8dp"
                        android:src="@drawable/qd_send"
                        app:tint="@color/white" />

                </LinearLayout>

            </LinearLayout>

            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/matrix_band"
                android:drawableEnd="@drawable/matrix_band"
                android:drawablePadding="8dp"
                android:drawableTint="?android:attr/textColorTertiary"
                android:text="@string/theme_section_accent" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/swatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:alignmentMode="alignBounds"
                app:columnCount="3"
                app:useDefaultMargins="false" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:id="@+id/proNote"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/theme_pro_note"
                android:visibility="gone"
                app:textFont="body" />

            <include
                android:id="@+id/hexPicker"
                layout="@layout/theme_hex_picker" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:id="@+id/resetConversationAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="16dp"
                style="@style/TextStamp"
                android:text="@string/theme_reset_conversation_accent"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                app:textSize="secondary" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="12dp"
        android:layout_height="match_parent"
        android:background="@drawable/sprocket_rail"
        android:importantForAccessibility="no" />

</FrameLayout>
