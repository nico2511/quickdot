<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/avatarA"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/rounded_rectangle_4dp" />

    <View
        android:id="@+id/bubbleA"
        android:layout_width="72dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/square_outline" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/bubbleB"
        android:layout_width="72dp"
        android:layout_height="24dp"
        android:background="@drawable/square_key" />

    <View
        android:id="@+id/avatarB"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/rounded_rectangle_4dp" />

</LinearLayout>
