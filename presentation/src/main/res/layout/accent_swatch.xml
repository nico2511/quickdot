<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/swatchFrame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/square_outline"
        android:padding="8dp">

        <ImageView
            android:id="@+id/swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_matrix_swatch" />

        <ImageView
            android:id="@+id/lock"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/theme_accent_locked_cd"
            android:src="@drawable/qd_lock"
            android:visibility="gone"
            app:tint="@color/white" />

    </FrameLayout>

    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/label"
        style="@style/TextStamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:maxLines="1" />

</LinearLayout>
