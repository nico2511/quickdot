<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/conversation_item_background"
    android:foreground="?attr/selectableItemBackground"
    android:nextFocusRight="@id/compose">

    <dev.octoshrimpy.quik.common.widget.GroupAvatarView
        android:id="@+id/avatars"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:monochrome="true" />

    <LinearLayout
        android:id="@+id/meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title">

        <ImageView
            android:id="@+id/unread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/circle"
            android:visibility="gone"
            tools:tint="@color/accent"
            tools:visibility="visible" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/date"
            style="@style/TextTertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:textFont="display"
            tools:text="12:41" />

    </LinearLayout>

    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/title"
        style="@style/TextPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:lines="1"
        android:textDirection="ltr"
        app:layout_constraintBottom_toTopOf="@id/snippet"
        app:layout_constraintEnd_toStartOf="@id/meta"
        app:layout_constraintStart_toEndOf="@id/avatars"
        app:layout_constraintTop_toTopOf="@id/avatars"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="@tools:sample/full_names" />

    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/snippet"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintEnd_toStartOf="@id/pinned"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="@tools:sample/lorem/random" />

    <ImageView
        android:id="@+id/pinned"
        android:layout_width="20dp"
        android:layout_height="16dp"
        android:paddingStart="4dp"
        android:src="@drawable/ic_baseline_push_pin_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/snippet"
        app:layout_constraintEnd_toStartOf="@id/scheduled"
        app:layout_constraintTop_toTopOf="@id/snippet"
        app:tint="?android:attr/textColorTertiary"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/scheduled"
        android:layout_width="20dp"
        android:layout_height="16dp"
        android:layout_marginEnd="20dp"
        android:paddingStart="4dp"
        android:src="@drawable/ic_event_black_24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/snippet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/snippet"
        app:tint="?android:attr/textColorTertiary"
        tools:visibility="visible" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="84dp"
        android:background="?android:attr/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
