<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/square_outline"
            android:orientation="vertical"
            android:padding="16dp">

            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/TextTertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/about_credits_title"
                android:textAllCaps="true"
                app:textFont="label" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_credits_names"
                android:textColor="?android:attr/textColorPrimary"
                app:textFont="display"
                app:textSize="secondary" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_credits" />

        </LinearLayout>

        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/PreferenceCategory"
            android:text="@string/settings_about_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_info"
            app:title="@string/about_version_title"
            tools:summary="0.1.1" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/developer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_person"
            app:summary="@string/about_developer"
            app:title="@string/about_developer_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_share"
            app:summary="@string/about_source"
            app:title="@string/about_source_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/upstream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_share"
            app:summary="@string/about_upstream"
            app:title="@string/about_upstream_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_history"
            app:summary="@string/about_changelog"
            app:title="@string/about_changelog_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_send"
            app:summary="@string/about_contact"
            app:title="@string/about_contact_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/license"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_title"
            app:summary="@string/about_license"
            app:title="@string/about_license_title" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/qd_info"
            app:summary="@string/about_copyright"
            app:title="@string/about_copyright_title" />

    </LinearLayout>

</ScrollView>

    <View
        android:layout_width="12dp"
        android:layout_height="match_parent"
        android:background="@drawable/sprocket_rail"
        android:importantForAccessibility="no" />

</FrameLayout>