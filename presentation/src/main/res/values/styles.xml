<resources>

    <style name="TextPrimary">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="textSize">primary</item>
    </style>

    <style name="TextSecondary">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="textSize">secondary</item>
    </style>

    <style name="TextTertiary">
        <item name="android:textColor">?android:attr/textColorTertiary</item>
        <item name="textSize">tertiary</item>
    </style>

    <!-- Dates, times, counters, badges, and chips. Bold display is what
         QkTextView.pinTypeface holds on Android 14. Capitals match names. -->
    <style name="TextStamp" parent="TextTertiary">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
    </style>

    <style name="TextSection" parent="TextStamp">
        <item name="android:letterSpacing">0.14</item>
    </style>

    <!-- Screen titles. fontFamily is the same pin as the thread title: Android 14
         otherwise resolves this bold display face back to the system sans. -->
    <style name="TextDisplay">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
        <item name="textSize">display</item>
    </style>

    <!-- Dialog and sheet titles. Same face as TextDisplay, size set by the view. -->
    <style name="TextHeadline">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
    </style>

    <!-- Conversation and contact names. Primary size so the row stays the same height.
         textAllCaps is display-only; the stored name and the sent message stay as typed. -->
    <style name="TextName" parent="TextPrimary">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
    </style>

    <!-- Drawer rows, settings entries, and dialog action lists. Secondary size keeps
         long French labels on one line inside the existing row. -->
    <style name="TextMenu">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
        <item name="textSize">secondary</item>
    </style>

    <!-- Framework popup and context menus are not QkTextViews, so they cannot pin.
         Point them at the bold file itself and do not ask for a synthetic bold. -->
    <style name="TextAppearance.Quickdot.PopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/doto_bold</item>
    </style>

    <style name="SearchSquare">
        <item name="android:background">@drawable/search_square</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableStart">@drawable/qd_search</item>
        <item name="android:drawableTint">?android:attr/textColorTertiary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:hint">@string/title_compose</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">textFilter|textNoSuggestions</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorTertiary</item>
        <item name="textSize">secondary</item>
    </style>

    <style name="SearchPill">
        <item name="android:background">@drawable/search_field</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableStart">@drawable/qd_search</item>
        <item name="android:drawableTint">?android:attr/textColorTertiary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:hint">@string/title_conversations</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorTertiary</item>
        <item name="textSize">secondary</item>
    </style>

    <style name="TextButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="textSize">secondary</item>
    </style>

    <style name="Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>

        <!-- This needs to be set so that we can tint the toolbar and not change the background
         resource. This is mainly so that QkReplyActivity can call setClipToOutline -->
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ToolbarText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textFont">display</item>
        <item name="textSize">toolbar</item>
    </style>

    <style name="PreferenceCategory" parent="TextSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:drawableStart">@drawable/matrix_band</item>
        <item name="android:drawableEnd">@drawable/matrix_band</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">?android:attr/textColorTertiary</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?android:attr/textColorTertiary</item>
        <item name="textSize">tertiary</item>
    </style>

    <style name="CollapsingToolbarCollapsedText">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
        <item name="textSize">toolbar</item>
    </style>

    <style name="CollapsingToolbarExpandedText">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textSize">44dp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/doto_bold</item>
    </style>

    <style name="ScheduledSampleTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/square_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="textSize">primary</item>
    </style>

    <style name="DrawerRow">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/drawer_row_background</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="DrawerText" parent="TextMenu">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="DrawerIcon">
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="DrawerMark">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/drawer_active_mark</item>
        <item name="android:tag">accentMark</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

</resources>
