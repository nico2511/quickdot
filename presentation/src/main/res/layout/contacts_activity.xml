<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context="dev.octoshrimpy.quik.feature.contacts.ContactsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent" />

    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/screenTitle"
        style="@style/TextDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/contacts_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <FrameLayout
        android:id="@+id/searchRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenTitle">

        <dev.octoshrimpy.quik.common.widget.QkEditText
            android:id="@+id/search"
            style="@style/SearchSquare"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:privateImeOptions="nm" />

        <ImageView
            android:id="@+id/cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/contacts_clear"
            android:padding="8dp"
            android:src="@drawable/ic_cancel_black_24dp"
            android:visibility="gone"
            app:tint="?android:attr/textColorSecondary"
            tools:visibility="visible" />

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchRow"
        tools:listitem="@layout/contact_chip"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/permission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/square_outline"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chips"
        tools:visibility="visible">

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/permissionMark"
            style="@style/TextDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:letterSpacing="0.4"
            android:text="@string/main_empty_mark"
            android:textColor="?android:attr/textColorTertiary" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/permissionTitle"
            style="@style/TextPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/contacts_permission_title" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/permissionMessage"
            style="@style/TextSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/main_permission_contacts" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/permissionButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/square_key"
            android:backgroundTint="@color/accent"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/main_permission_allow"
            android:textColor="@color/white"
            app:textFont="label"
            app:textSize="secondary" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contacts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:textDirection="ltr"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/permission"
        tools:listitem="@layout/contact_list_item" />

    <View
        android:id="@+id/sprocket"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:background="@drawable/sprocket_rail"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/contacts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/contacts" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/permission"
        tools:visibility="gone">

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/emptyMark"
            style="@style/TextDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:letterSpacing="0.4"
            android:text="@string/main_empty_mark"
            android:textColor="?android:attr/textColorTertiary" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/emptyTitle"
            style="@style/TextPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/contacts_empty_title" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/emptyMessage"
            style="@style/TextSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/contacts_empty_message" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
